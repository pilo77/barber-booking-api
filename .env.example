# Local development only. Copy to .env and replace placeholders.
# Do not commit .env or any real secret values.

SERVER_PORT=8080

POSTGRES_DB=barber_booking
POSTGRES_USER=barber_user
POSTGRES_PASSWORD=<set-local-password>
POSTGRES_PORT=5432

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/barber_booking
SPRING_DATASOURCE_USERNAME=barber_user
SPRING_DATASOURCE_PASSWORD=<set-local-password>
