# Local development only. Copy to .env and replace placeholders.
# Do not commit .env or any real secret values.

SERVER_PORT=8080
BOOKING_SLOT_STEP_MINUTES=15
BOOKING_TIME_ZONE=America/Bogota
APP_JWT_SECRET=<set-local-dev-secret-with-at-least-32-chars>
APP_JWT_EXPIRATION_MINUTES=60
APP_BOOTSTRAP_TOKEN=<set-local-bootstrap-token>
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200

POSTGRES_DB=barber_booking
POSTGRES_USER=barber_user
POSTGRES_PASSWORD=<set-local-password>
POSTGRES_PORT=5432

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/barber_booking
SPRING_DATASOURCE_USERNAME=barber_user
SPRING_DATASOURCE_PASSWORD=<set-local-password>

# Subscription: manual transfer instructions must be configured per environment.
# Never commit the real bank key, account holder or credentials.
BILLING_BASIC_AMOUNT_IN_CENTS=4000000
BILLING_MANUAL_INSTRUCTIONS=
WOMPI_ENABLED=false

# First platform administrator only. Disabled by default.
# Use secret environment fields and remove the initial password after provisioning.
PLATFORM_OWNER_PROVISIONING_ENABLED=false
PLATFORM_OWNER_EMAIL=
PLATFORM_OWNER_NAME=
PLATFORM_OWNER_INITIAL_PASSWORD=
